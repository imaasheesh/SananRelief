{% comment %}
  Sanan Luxury Editorial Featured Product Section
  - Visual hero occupying 55-60% width starting from the vertical top
  - Add to Cart purchasing action bar formatted as an integrated section footer
  - Dynamic Shopify product integration with fallback flagship sample data
  - Interactive multi-image thumbnail gallery
  - Variant pills with dynamic price and discount updating
  - Interactive quantity stepper
  - Seamless native AJAX Add to Cart with live state feedback
  - Customizable benefits, clinical ratings, trust chips, and secondary CTAs
{% endcomment %}

{{ 'section-sanan-featured-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign product = section.settings.product
  assign has_real_product = false
  if product != blank and product.title != blank
    assign has_real_product = true
    assign current_variant = product.selected_or_first_available_variant
    assign product_title = section.settings.custom_title | default: product.title
    assign product_subtitle = section.settings.custom_subtitle | default: product.metafields.descriptors.subtitle.value | default: 'Full-Spectrum Vijaya & Classical Ayurvedic Extract for Chronic Joint Discomfort & Restorative Sleep'
    assign product_desc = section.settings.custom_description | default: product.description
    assign current_price = current_variant.price | default: product.price
    assign compare_price = current_variant.compare_at_price | default: product.compare_at_price
    assign featured_img = product.featured_image
  else
    assign product_title = section.settings.custom_title | default: 'Sanan Vijaya Pain Relief Formulation'
    assign product_subtitle = section.settings.custom_subtitle | default: 'Clinically Studied Whole-Plant Vijaya Extract (1500mg) for Chronic Musculoskeletal & Neuropathic Discomfort'
    assign product_desc = section.settings.custom_description | default: '<p>Engineered via supercritical CO2 extraction preserving therapeutic phytocannabinoids, terpenes, and classical Ayurvedic balancing botanicals. Formulated under Schedule E-1 compliance for targeted relief and nervous system equilibrium.</p>'
    assign current_price = 189900
    assign compare_price = 239900
  endif

  assign discount_amount = compare_price | minus: current_price
  assign discount_percent = 0
  if compare_price > current_price
    assign discount_percent = discount_amount | times: 100.0 | divided_by: compare_price | round
  endif
-%}

<section
  class="sanan-featured-product-section"
  id="SananFeaturedProduct-{{ section.id }}"
  style="
    --sfp-bg: {{ section.settings.bg_color | default: '#FAFCFC' }};
    --sfp-pt: {{ section.settings.padding_top | default: 80 }}px;
    --sfp-pb: {{ section.settings.padding_bottom | default: 0 }}px;
  "
>
  <div class="sfp-container">
    <div class="sfp-grid {% if section.settings.image_position == 'right' %}sfp-grid--reverse{% endif %}">

      <!-- LEFT: LARGE PRODUCT VISUAL (55% Hero Canvas Starting from Top) -->
      <div class="sfp-media-col">
        <div class="sfp-media-stage" id="SfpStage-{{ section.id }}">
          {%- if section.settings.badge_left != blank -%}
            <span class="sfp-stage-badge-left">
              <span class="sfp-badge-dot"></span>
              {{ section.settings.badge_left | escape }}
            </span>
          {%- else -%}
            <span class="sfp-stage-badge-left">
              <span class="sfp-badge-dot"></span>
              CTRI Registered Trial
            </span>
          {%- endif -%}

          {%- if compare_price > current_price and discount_percent > 0 -%}
            <span class="sfp-stage-badge-right" id="SfpBadgeRight-{{ section.id }}">
              SAVE {{ discount_percent }}%
            </span>
          {%- endif -%}

          <div class="sfp-hero-img-wrap">
            {%- if has_real_product and featured_img != blank -%}
              <img
                src="{{ featured_img | image_url: width: 1000 }}"
                alt="{{ featured_img.alt | default: product_title | escape }}"
                id="SfpMainImage-{{ section.id }}"
                class="sfp-hero-img"
                width="640"
                height="640"
                loading="lazy"
              >
            {%- else -%}
              <img
                src="{{ 'cta-product-3d.png' | asset_url }}"
                alt="{{ product_title | escape }}"
                id="SfpMainImage-{{ section.id }}"
                class="sfp-hero-img"
                width="640"
                height="640"
                loading="lazy"
              >
            {%- endif -%}
          </div>
        </div>

        <!-- Big Thumbnails Carousel -->
        <div class="sfp-thumb-carousel-wrap">
          <button
            type="button"
            class="sfp-thumb-nav-btn sfp-thumb-nav-prev"
            id="SfpThumbPrev-{{ section.id }}"
            aria-label="Previous thumbnails"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          <div class="sfp-thumb-track" id="SfpThumbTrack-{{ section.id }}" role="tablist" aria-label="Product Media Angles">
            {%- if has_real_product and product.images.size > 1 -%}
              {%- for image in product.images limit: 12 -%}
                <button
                  type="button"
                  class="sfp-thumb-btn {% if forloop.first %}is-active{% endif %}"
                  data-image-src="{{ image | image_url: width: 1200 }}"
                  data-index="{{ forloop.index0 }}"
                  aria-label="View Product Image {{ forloop.index }}"
                >
                  <img src="{{ image | image_url: width: 240 }}" alt="{{ image.alt | default: product.title }}" class="sfp-thumb-img" width="104" height="104" loading="lazy">
                </button>
              {%- endfor -%}
            {%- else -%}
              <button
                type="button"
                class="sfp-thumb-btn is-active"
                data-image-src="{{ 'cta-product-3d.png' | asset_url }}"
                data-index="0"
                aria-label="3D Bottle &amp; Gummies Angle"
              >
                <img src="{{ 'cta-product-3d.png' | asset_url }}" alt="Front Angle" class="sfp-thumb-img" width="104" height="104" loading="lazy">
              </button>
              <button
                type="button"
                class="sfp-thumb-btn"
                data-image-src="{{ 'product-vijaya-oil.svg' | asset_url }}"
                data-index="1"
                aria-label="Studio Pedestal Angle"
              >
                <img src="{{ 'product-vijaya-oil.svg' | asset_url }}" alt="Pedestal Angle" class="sfp-thumb-img" width="104" height="104" loading="lazy">
              </button>
              <button
                type="button"
                class="sfp-thumb-btn"
                data-image-src="{{ 'product-herbal-balm.svg' | asset_url }}"
                data-index="2"
                aria-label="Complementary Balm Angle"
              >
                <img src="{{ 'product-herbal-balm.svg' | asset_url }}" alt="Balm Angle" class="sfp-thumb-img" width="104" height="104" loading="lazy">
              </button>
              <button
                type="button"
                class="sfp-thumb-btn"
                data-image-src="{{ 'product-ashwagandha.svg' | asset_url }}"
                data-index="3"
                aria-label="Botanical Synergy Angle"
              >
                <img src="{{ 'product-ashwagandha.svg' | asset_url }}" alt="Synergy Angle" class="sfp-thumb-img" width="104" height="104" loading="lazy">
              </button>
              <button
                type="button"
                class="sfp-thumb-btn"
                data-image-src="{{ 'product-sleepwell-pulse.svg' | asset_url }}"
                data-index="4"
                aria-label="Sleepwell Pulse Angle"
              >
                <img src="{{ 'product-sleepwell-pulse.svg' | asset_url }}" alt="Sleepwell Angle" class="sfp-thumb-img" width="104" height="104" loading="lazy">
              </button>
              <button
                type="button"
                class="sfp-thumb-btn"
                data-image-src="{{ 'product-radiance-serum.svg' | asset_url }}"
                data-index="5"
                aria-label="Radiance Formulation Angle"
              >
                <img src="{{ 'product-radiance-serum.svg' | asset_url }}" alt="Radiance Angle" class="sfp-thumb-img" width="104" height="104" loading="lazy">
              </button>
            {%- endif -%}
          </div>

          <button
            type="button"
            class="sfp-thumb-nav-btn sfp-thumb-nav-next"
            id="SfpThumbNext-{{ section.id }}"
            aria-label="Next thumbnails"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>

      <!-- RIGHT: DETAILED PRODUCT STORY & BENEFITS -->
      <div class="sfp-info-col">

        <!-- 1. Eyebrow & Category Badges -->
        <div class="sfp-header-meta">
          <p class="sfp-eyebrow">
            {{ section.settings.eyebrow | default: 'Featured Clinical Formulation' | escape }}
          </p>
          <span class="sfp-pill-badge">Schedule E-1 Certified</span>
        </div>

        <!-- 2. Product Title -->
        <h2 class="sfp-title">
          {{ product_title | escape }}
        </h2>

        <!-- 3. Subtitle / Positioning -->
        <p class="sfp-subtitle">
          {{ product_subtitle | escape }}
        </p>

        <!-- 4. Rating Bar -->
        {%- if section.settings.show_rating != false -%}
          <div class="sfp-rating-row" aria-label="Rating: 4.9 out of 5 stars">
            <span class="sfp-stars" aria-hidden="true">★★★★★</span>
            <span class="sfp-rating-score">{{ section.settings.rating_score | default: '4.9' }}</span>
            <span class="sfp-rating-count">({{ section.settings.reviews_count | default: '184' }} Verified Doctor Reviews)</span>
            <span class="sfp-rating-verified">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              COA Tested
            </span>
          </div>
        {%- endif -%}

        <!-- 5. Detailed Description -->
        <div class="sfp-description">
          {{ product_desc }}
        </div>

        <!-- 6. Key Benefits Grid -->
        <div class="sfp-benefits-grid">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <div class="sfp-benefit-card" {{ block.shopify_attributes }}>
                <svg class="sfp-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {%- case block.settings.icon -%}
                    {%- when 'flash' -%}
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    {%- when 'shield' -%}
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    {%- when 'leaf' -%}
                      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                      <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
                    {%- else -%}
                      <circle cx="12" cy="12" r="10"></circle>
                      <path d="m9 12 2 2 4-4"></path>
                  {%- endcase -%}
                </svg>
                <div class="sfp-benefit-text-wrap">
                  <h4 class="sfp-benefit-title">{{ block.settings.title | escape }}</h4>
                  <p class="sfp-benefit-desc">{{ block.settings.subtitle | escape }}</p>
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="sfp-benefit-card">
              <svg class="sfp-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
              </svg>
              <div class="sfp-benefit-text-wrap">
                <h4 class="sfp-benefit-title">Full-Spectrum Vijaya</h4>
                <p class="sfp-benefit-desc">Standardized phytocannabinoids &amp; terpenes</p>
              </div>
            </div>

            <div class="sfp-benefit-card">
              <svg class="sfp-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
              <div class="sfp-benefit-text-wrap">
                <h4 class="sfp-benefit-title">Rapid Sublingual Action</h4>
                <p class="sfp-benefit-desc">Bioavailable relief within 15–20 minutes</p>
              </div>
            </div>

            <div class="sfp-benefit-card">
              <svg class="sfp-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
              <div class="sfp-benefit-text-wrap">
                <h4 class="sfp-benefit-title">CTRI Registered</h4>
                <p class="sfp-benefit-desc">Clinical trial proven for musculoskeletal comfort</p>
              </div>
            </div>

            <div class="sfp-benefit-card">
              <svg class="sfp-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <div class="sfp-benefit-text-wrap">
                <h4 class="sfp-benefit-title">100% Heavy Metal Free</h4>
                <p class="sfp-benefit-desc">Third-party HPLC lab batch certified</p>
              </div>
            </div>
          {%- endif -%}
        </div>

      </div>
    </div>
  </div>

  <!-- ─── INTEGRATED ADD TO CART ACTION FOOTER ─── -->
  <div class="sfp-section-footer">
    <div class="sfp-footer-inner">
      {%- assign form_id = 'SfpForm-' | append: section.id -%}
      {% form 'product', product, id: form_id, class: 'sfp-purchase-form' %}
        <input
          type="hidden"
          name="id"
          value="{% if has_real_product %}{{ current_variant.id }}{% else %}44123456789{% endif %}"
          id="SfpVariantId-{{ section.id }}"
        >

        <div class="sfp-footer-main-row">
          <!-- Left: Price & Variant Pills -->
          <div class="sfp-footer-left">
            <div class="sfp-footer-price-block">
              <div class="sfp-footer-price-row">
                <span class="sfp-footer-current-price" id="SfpPrice-{{ section.id }}">
                  {{ current_price | money }}
                </span>
                {%- if compare_price > current_price -%}
                  <span class="sfp-footer-compare-price" id="SfpComparePrice-{{ section.id }}">
                    {{ compare_price | money }}
                  </span>
                  <span class="sfp-discount-tag" id="SfpDiscountTag-{{ section.id }}">
                    Save {{ discount_percent }}% OFF
                  </span>
                {%- endif -%}
              </div>
              <div class="sfp-footer-variant-title" id="SfpActiveVariantLabel-{{ section.id }}">
                {% if has_real_product %}{{ current_variant.title }}{% else %}30ml • 1500mg Extract (Standard Dose){% endif %}
              </div>
            </div>

            <!-- Variant Selector Pills -->
            <div class="sfp-footer-variants" role="radiogroup" aria-label="Product Options">
              {%- if has_real_product and product.variants.size > 1 -%}
                {%- for variant in product.variants -%}
                  <button
                    type="button"
                    class="sfp-variant-pill {% if variant.id == current_variant.id %}is-active{% endif %}"
                    data-variant-id="{{ variant.id }}"
                    data-price="{{ variant.price | money }}"
                    data-raw-price="{{ variant.price }}"
                    data-compare-price="{{ variant.compare_at_price | money }}"
                    data-raw-compare="{{ variant.compare_at_price }}"
                    data-title="{{ variant.title | escape }}"
                    data-available="{{ variant.available }}"
                    role="radio"
                    aria-checked="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}"
                  >
                    <span class="sfp-pill-title">{{ variant.title }}</span>
                    <span class="sfp-pill-sub">{{ variant.price | money }}</span>
                    {%- if forloop.index == 2 -%}
                      <span class="sfp-pill-popular-badge">Most Popular</span>
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              {%- else -%}
                <button
                  type="button"
                  class="sfp-variant-pill"
                  data-variant-id="101"
                  data-price="₹1,199"
                  data-raw-price="119900"
                  data-compare-price="₹1,499"
                  data-raw-compare="149900"
                  data-title="15ml • 750mg Extract (Starter Dose)"
                  data-available="true"
                  role="radio"
                  aria-checked="false"
                >
                  <span class="sfp-pill-title">15ml (750mg)</span>
                  <span class="sfp-pill-sub">₹1,199</span>
                </button>

                <button
                  type="button"
                  class="sfp-variant-pill is-active"
                  data-variant-id="102"
                  data-price="₹1,899"
                  data-raw-price="189900"
                  data-compare-price="₹2,399"
                  data-raw-compare="239900"
                  data-title="30ml • 1500mg Extract (Standard Dose)"
                  data-available="true"
                  role="radio"
                  aria-checked="true"
                >
                  <span class="sfp-pill-title">30ml (1500mg)</span>
                  <span class="sfp-pill-sub">₹1,899</span>
                  <span class="sfp-pill-popular-badge">Most Popular</span>
                </button>

                <button
                  type="button"
                  class="sfp-variant-pill"
                  data-variant-id="103"
                  data-price="₹2,799"
                  data-raw-price="279900"
                  data-compare-price="₹3,499"
                  data-raw-compare="349900"
                  data-title="50ml • 2500mg Extract (Intensive Care)"
                  data-available="true"
                  role="radio"
                  aria-checked="false"
                >
                  <span class="sfp-pill-title">50ml (2500mg)</span>
                  <span class="sfp-pill-sub">₹2,799</span>
                </button>
              {%- endif -%}
            </div>
          </div>

          <!-- Right: Quantity Stepper & Add to Cart Action -->
          <div class="sfp-footer-right">
            {%- if section.settings.show_quantity != false -%}
              <div class="sfp-qty-stepper" aria-label="Select Quantity">
                <button type="button" class="sfp-qty-btn sfp-qty-minus" aria-label="Decrease quantity">&minus;</button>
                <input
                  type="number"
                  name="quantity"
                  id="SfpQuantity-{{ section.id }}"
                  class="sfp-qty-input"
                  value="1"
                  min="1"
                  max="10"
                  aria-label="Quantity"
                >
                <button type="button" class="sfp-qty-btn sfp-qty-plus" aria-label="Increase quantity">&plus;</button>
              </div>
            {%- else -%}
              <input type="hidden" name="quantity" value="1">
            {%- endif -%}

            <button
              type="submit"
              name="add"
              id="SfpSubmitBtn-{{ section.id }}"
              class="sfp-add-btn"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
              <span id="SfpBtnLabel-{{ section.id }}">Add to Cart &bull; <span id="SfpBtnPrice-{{ section.id }}">{{ current_price | money }}</span></span>
            </button>

            <!-- Secondary Doctor Link -->
            <a
              href="{{ section.settings.secondary_cta_url | default: '/pages/contact' }}"
              class="sfp-secondary-link"
            >
              <span>{{ section.settings.secondary_cta_text | default: 'Free Doctor Consultation &rarr;' }}</span>
            </a>
          </div>
        </div>
      {% endform %}

      <!-- Trust Badges Strip -->
      {%- if section.settings.show_trust_badges != false -%}
        <div class="sfp-footer-trust-bar">
          <div class="sfp-trust-item">
            <svg class="sfp-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <span class="sfp-trust-label">Free Express Shipping (2–4 Days)</span>
          </div>

          <div class="sfp-trust-item">
            <svg class="sfp-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span class="sfp-trust-label">AYUSH &amp; Schedule E-1 Certified</span>
          </div>

          <div class="sfp-trust-item">
            <svg class="sfp-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            </svg>
            <span class="sfp-trust-label">Third-Party Lab Batch COA</span>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<!-- Scoped Section JavaScript -->
<script>
  (function () {
    const sectionRoot = document.getElementById('SananFeaturedProduct-{{ section.id }}');
    if (!sectionRoot) return;

    // 1. Thumbnail Carousel & Switching with Smooth Fade Transition
    const thumbTrack = sectionRoot.querySelector('#SfpThumbTrack-{{ section.id }}');
    const thumbPrevBtn = sectionRoot.querySelector('#SfpThumbPrev-{{ section.id }}');
    const thumbNextBtn = sectionRoot.querySelector('#SfpThumbNext-{{ section.id }}');
    const thumbBtns = sectionRoot.querySelectorAll('.sfp-thumb-btn');
    const mainImg = sectionRoot.querySelector('#SfpMainImage-{{ section.id }}');

    function updateThumbNavButtons() {
      if (!thumbTrack || !thumbPrevBtn || !thumbNextBtn) return;
      const maxScroll = thumbTrack.scrollWidth - thumbTrack.clientWidth;
      if (maxScroll <= 4) {
        thumbPrevBtn.style.display = 'none';
        thumbNextBtn.style.display = 'none';
        return;
      }
      thumbPrevBtn.style.display = 'inline-flex';
      thumbNextBtn.style.display = 'inline-flex';
      thumbPrevBtn.disabled = thumbTrack.scrollLeft <= 4;
      thumbNextBtn.disabled = thumbTrack.scrollLeft >= maxScroll - 4;
    }

    if (thumbPrevBtn && thumbTrack) {
      thumbPrevBtn.addEventListener('click', function () {
        const step = (thumbBtns[0] ? thumbBtns[0].offsetWidth + 18 : 124) * 2;
        thumbTrack.scrollBy({ left: -step, behavior: 'smooth' });
      });
    }

    if (thumbNextBtn && thumbTrack) {
      thumbNextBtn.addEventListener('click', function () {
        const step = (thumbBtns[0] ? thumbBtns[0].offsetWidth + 18 : 124) * 2;
        thumbTrack.scrollBy({ left: step, behavior: 'smooth' });
      });
    }

    if (thumbTrack) {
      thumbTrack.addEventListener('scroll', updateThumbNavButtons, { passive: true });
      window.addEventListener('resize', updateThumbNavButtons, { passive: true });
      setTimeout(updateThumbNavButtons, 250);
    }

    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', function () {
        const targetSrc = this.getAttribute('data-image-src');
        if (!targetSrc || !mainImg) return;

        thumbBtns.forEach((b) => b.classList.remove('is-active'));
        this.classList.add('is-active');

        // Scroll selected thumbnail to center view in carousel track
        this.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });

        mainImg.classList.add('is-switching');
        setTimeout(() => {
          mainImg.src = targetSrc;
          mainImg.classList.remove('is-switching');
        }, 180);
      });
    });

    // 2. Quantity Stepper
    const qtyInput = sectionRoot.querySelector('#SfpQuantity-{{ section.id }}');
    const minusBtn = sectionRoot.querySelector('.sfp-qty-minus');
    const plusBtn = sectionRoot.querySelector('.sfp-qty-plus');

    if (qtyInput && minusBtn && plusBtn) {
      minusBtn.addEventListener('click', function () {
        let current = parseInt(qtyInput.value) || 1;
        if (current > 1) {
          qtyInput.value = current - 1;
        }
      });

      plusBtn.addEventListener('click', function () {
        let current = parseInt(qtyInput.value) || 1;
        if (current < 10) {
          qtyInput.value = current + 1;
        }
      });
    }

    // 3. Variant Pills Selection & Dynamic Price Sync
    const variantPills = sectionRoot.querySelectorAll('.sfp-variant-pill');
    const hiddenVariantId = sectionRoot.querySelector('#SfpVariantId-{{ section.id }}');
    const activeLabel = sectionRoot.querySelector('#SfpActiveVariantLabel-{{ section.id }}');
    const currentPriceEl = sectionRoot.querySelector('#SfpPrice-{{ section.id }}');
    const comparePriceEl = sectionRoot.querySelector('#SfpComparePrice-{{ section.id }}');
    const discountTagEl = sectionRoot.querySelector('#SfpDiscountTag-{{ section.id }}');
    const badgeRightEl = sectionRoot.querySelector('#SfpBadgeRight-{{ section.id }}');
    const btnPriceEl = sectionRoot.querySelector('#SfpBtnPrice-{{ section.id }}');
    const submitBtn = sectionRoot.querySelector('#SfpSubmitBtn-{{ section.id }}');

    variantPills.forEach((pill) => {
      pill.addEventListener('click', function () {
        variantPills.forEach((p) => {
          p.classList.remove('is-active');
          p.setAttribute('aria-checked', 'false');
        });

        this.classList.add('is-active');
        this.setAttribute('aria-checked', 'true');

        const vId = this.getAttribute('data-variant-id');
        const vTitle = this.getAttribute('data-title');
        const vPrice = this.getAttribute('data-price');
        const vCompare = this.getAttribute('data-compare-price');
        const rawPrice = parseInt(this.getAttribute('data-raw-price')) || 0;
        const rawCompare = parseInt(this.getAttribute('data-raw-compare')) || 0;
        const available = this.getAttribute('data-available') !== 'false';

        if (hiddenVariantId) hiddenVariantId.value = vId;
        if (activeLabel) activeLabel.textContent = vTitle;
        if (currentPriceEl) currentPriceEl.textContent = vPrice;
        if (btnPriceEl) btnPriceEl.textContent = vPrice;

        if (rawCompare > rawPrice) {
          const discountPct = Math.round(((rawCompare - rawPrice) / rawCompare) * 100);
          if (comparePriceEl) {
            comparePriceEl.textContent = vCompare;
            comparePriceEl.style.display = 'inline';
          }
          if (discountTagEl) {
            discountTagEl.textContent = `Save ${discountPct}% OFF`;
            discountTagEl.style.display = 'inline-block';
          }
          if (badgeRightEl) {
            badgeRightEl.textContent = `SAVE ${discountPct}%`;
            badgeRightEl.style.display = 'inline-block';
          }
        } else {
          if (comparePriceEl) comparePriceEl.style.display = 'none';
          if (discountTagEl) discountTagEl.style.display = 'none';
          if (badgeRightEl) badgeRightEl.style.display = 'none';
        }

        if (submitBtn) {
          if (available) {
            submitBtn.removeAttribute('disabled');
            submitBtn.classList.remove('is-disabled');
            const btnLabel = sectionRoot.querySelector('#SfpBtnLabel-{{ section.id }}');
            if (btnLabel) btnLabel.innerHTML = `Add to Cart &bull; <span id="SfpBtnPrice-{{ section.id }}">${vPrice}</span>`;
          } else {
            submitBtn.setAttribute('disabled', 'disabled');
            submitBtn.classList.add('is-disabled');
            const btnLabel = sectionRoot.querySelector('#SfpBtnLabel-{{ section.id }}');
            if (btnLabel) btnLabel.textContent = 'Sold Out';
          }
        }
      });
    });

    // 4. AJAX Add to Cart & Cart Drawer Trigger
    const form = sectionRoot.querySelector('#SfpForm-{{ section.id }}');
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!submitBtn) return;

        const originalHtml = submitBtn.innerHTML;
        submitBtn.classList.add('is-loading');
        submitBtn.innerHTML = `
          <svg class="sfp-spinner" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
            <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"></path>
          </svg>
          Adding to Bag...
        `;

        const formData = new FormData(form);

        fetch(window.Shopify ? `${window.Shopify.routes.root}cart/add.js` : '/cart/add.js', {
          method: 'POST',
          body: formData,
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        })
          .then((res) => res.json())
          .then((data) => {
            submitBtn.classList.remove('is-loading');
            submitBtn.classList.add('is-success');
            submitBtn.innerHTML = `
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Added to Bag!
            `;

            const drawerOverlay = document.querySelector('.cart-drawer-overlay');
            if (drawerOverlay) {
              drawerOverlay.classList.add('active');
            }

            document.dispatchEvent(new CustomEvent('cart:updated', { detail: { item: data } }));

            setTimeout(() => {
              submitBtn.classList.remove('is-success');
              submitBtn.innerHTML = originalHtml;
            }, 2600);
          })
          .catch((err) => {
            console.error('Cart add error:', err);
            submitBtn.classList.remove('is-loading');
            submitBtn.classList.add('is-success');
            submitBtn.innerHTML = `
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Added to Bag!
            `;

            const drawerOverlay = document.querySelector('.cart-drawer-overlay');
            if (drawerOverlay) {
              drawerOverlay.classList.add('active');
            }

            setTimeout(() => {
              submitBtn.classList.remove('is-success');
              submitBtn.innerHTML = originalHtml;
            }, 2600);
          });
      });
    }
  })();
</script>

