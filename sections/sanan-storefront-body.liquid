  <script>
    (function () {
      const sectionRoot = document.getElementById('SananFeaturedProduct-preview');
      if (!sectionRoot) return;

      // 1. Thumbnail Carousel & Switching with Smooth Fade Transition
      const thumbTrack = sectionRoot.querySelector('#SfpThumbTrack-preview');
      const thumbPrevBtn = sectionRoot.querySelector('#SfpThumbPrev-preview');
      const thumbNextBtn = sectionRoot.querySelector('#SfpThumbNext-preview');
      const thumbBtns = sectionRoot.querySelectorAll('.sfp-thumb-btn');
      const mainImg = sectionRoot.querySelector('#SfpMainImage-preview');

      function updateThumbNavButtons() {
        if (!thumbTrack || !thumbPrevBtn || !thumbNextBtn) return;
        const maxScroll = thumbTrack.scrollWidth - thumbTrack.clientWidth;
        if (maxScroll <= 4) {
          thumbPrevBtn.style.display = 'none';
          thumbNextBtn.style.display = 'none';
          return;
        }
        thumbPrevBtn.style.display = 'inline-flex';
        thumbNextBtn.style.display = 'inline-flex';
        thumbPrevBtn.disabled = thumbTrack.scrollLeft <= 4;
        thumbNextBtn.disabled = thumbTrack.scrollLeft >= maxScroll - 4;
      }

      if (thumbPrevBtn && thumbTrack) {
        thumbPrevBtn.addEventListener('click', function () {
          const step = (thumbBtns[0] ? thumbBtns[0].offsetWidth + 18 : 124) * 2;
          thumbTrack.scrollBy({ left: -step, behavior: 'smooth' });
        });
      }

      if (thumbNextBtn && thumbTrack) {
        thumbNextBtn.addEventListener('click', function () {
          const step = (thumbBtns[0] ? thumbBtns[0].offsetWidth + 18 : 124) * 2;
          thumbTrack.scrollBy({ left: step, behavior: 'smooth' });
        });
      }

      if (thumbTrack) {
        thumbTrack.addEventListener('scroll', updateThumbNavButtons, { passive: true });
        window.addEventListener('resize', updateThumbNavButtons, { passive: true });
        setTimeout(updateThumbNavButtons, 250);
      }

      thumbBtns.forEach((btn) => {
        btn.addEventListener('click', function () {
          const targetSrc = this.getAttribute('data-image-src');
          if (!targetSrc || !mainImg) return;

          thumbBtns.forEach((b) => b.classList.remove('is-active'));
          this.classList.add('is-active');

          // Scroll active thumbnail to center of view
          this.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });

          mainImg.classList.add('is-switching');
          setTimeout(() => {
            mainImg.src = targetSrc;
            mainImg.classList.remove('is-switching');
          }, 180);
        });
      });

      // 2. Quantity Stepper
      const qtyInput = sectionRoot.querySelector('#SfpQuantity-preview');
      const minusBtn = sectionRoot.querySelector('.sfp-qty-minus');
      const plusBtn = sectionRoot.querySelector('.sfp-qty-plus');

      if (qtyInput && minusBtn && plusBtn) {
        minusBtn.addEventListener('click', function () {
          let current = parseInt(qtyInput.value) || 1;
          if (current > 1) qtyInput.value = current - 1;
        });

        plusBtn.addEventListener('click', function () {
          let current = parseInt(qtyInput.value) || 1;
          if (current < 10) qtyInput.value = current + 1;
        });
      }

      // 3. Variant Pills Selection & Dynamic Price Sync
      const variantPills = sectionRoot.querySelectorAll('.sfp-variant-pill');
      const hiddenVariantId = sectionRoot.querySelector('#SfpVariantId-preview');
      const activeLabel = sectionRoot.querySelector('#SfpActiveVariantLabel-preview');
      const currentPriceEl = sectionRoot.querySelector('#SfpPrice-preview');
      const comparePriceEl = sectionRoot.querySelector('#SfpComparePrice-preview');
      const discountTagEl = sectionRoot.querySelector('#SfpDiscountTag-preview');
      const badgeRightEl = sectionRoot.querySelector('#SfpBadgeRight-preview');
      const btnPriceEl = sectionRoot.querySelector('#SfpBtnPrice-preview');
      const submitBtn = sectionRoot.querySelector('#SfpSubmitBtn-preview');

      variantPills.forEach((pill) => {
        pill.addEventListener('click', function () {
          variantPills.forEach((p) => {
            p.classList.remove('is-active');
            p.setAttribute('aria-checked', 'false');
          });

          this.classList.add('is-active');
          this.setAttribute('aria-checked', 'true');

          const vId = this.getAttribute('data-variant-id');
          const vTitle = this.getAttribute('data-title');
          const vPrice = this.getAttribute('data-price');
          const vCompare = this.getAttribute('data-compare-price');
          const rawPrice = parseInt(this.getAttribute('data-raw-price')) || 0;
          const rawCompare = parseInt(this.getAttribute('data-raw-compare')) || 0;

          if (hiddenVariantId) hiddenVariantId.value = vId;
          if (activeLabel) activeLabel.textContent = vTitle;
          if (currentPriceEl) currentPriceEl.textContent = vPrice;
          if (btnPriceEl) btnPriceEl.textContent = vPrice;

          if (rawCompare > rawPrice) {
            const discountPct = Math.round(((rawCompare - rawPrice) / rawCompare) * 100);
            if (comparePriceEl) {
              comparePriceEl.textContent = vCompare;
              comparePriceEl.style.display = 'inline';
            }
            if (discountTagEl) {
              discountTagEl.textContent = `Save ${discountPct}% OFF`;
              discountTagEl.style.display = 'inline-block';
            }
            if (badgeRightEl) {
              badgeRightEl.textContent = `SAVE ${discountPct}%`;
              badgeRightEl.style.display = 'inline-block';
            }
          }
        });
      });

      // 4. Add to Cart with live feedback and Cart Drawer opening
      const form = sectionRoot.querySelector('#SfpForm-preview');
      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          if (!submitBtn) return;

          const originalHtml = submitBtn.innerHTML;
          submitBtn.classList.add('is-loading');
          submitBtn.innerHTML = `
            <svg class="sfp-spinner" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
              <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"></path>
            </svg>
            Adding to Bag...
          `;

          setTimeout(() => {
            submitBtn.classList.remove('is-loading');
            submitBtn.classList.add('is-success');
            submitBtn.innerHTML = `
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Added to Bag!
            `;

            const drawerOverlay = document.querySelector('.cart-drawer-overlay');
            if (drawerOverlay) {
              drawerOverlay.classList.add('active');
            }

            setTimeout(() => {
              submitBtn.classList.remove('is-success');
              submitBtn.innerHTML = originalHtml;
            }, 2600);
          }, 600);
        });
      }
    })();
  </script>

