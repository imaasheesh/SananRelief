{{ 'sanan-account.css' | asset_url | stylesheet_tag }}

<div class="sanan-account-wrapper">
  <div class="sanan-account-container">

    <nav class="sanan-account-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      <span style="color:var(--color-secondary); font-weight:600;">Patient Account</span>
    </nav>

    <section class="account-hero-banner">
      <div class="account-greeting-wrap">
        <div class="account-avatar-circle">
          {{ customer.first_name | slice: 0 | default: 'P' }}
        </div>
        <div>
          <div class="account-greeting-kicker">Ayush Verified Patient</div>
          <h1 class="account-greeting-title">
            Namaste, {{ customer.name | default: 'Valued Patient' }}
          </h1>
          <div class="account-meta-line">{{ customer.email }}</div>
        </div>
      </div>
      <div class="account-hero-actions">
        <div class="wellness-tier-badge">
          <span>🌿</span>
          <span>Sanan Wellness Circle: <strong>Active Patient</strong></span>
        </div>
        <a href="{{ routes.account_logout_url }}" class="btn-logout">Sign Out</a>
      </div>
    </section>

    <div class="account-layout-grid">
      <aside class="account-nav-card">
        <nav class="account-nav-list" aria-label="Account Tabs">
          <button type="button" class="account-nav-item is-active" data-tab="tab-orders">
            <span class="account-nav-icon">📦</span>
            <span>Orders &amp; Reorder</span>
          </button>
          <button type="button" class="account-nav-item" data-tab="tab-vault">
            <span class="account-nav-icon">🩺</span>
            <span>Prescription Vault</span>
          </button>
          <button type="button" class="account-nav-item" data-tab="tab-addresses">
            <span class="account-nav-icon">📍</span>
            <span>Saved Addresses</span>
          </button>
          <button type="button" class="account-nav-item" data-tab="tab-health">
            <span class="account-nav-icon">🍃</span>
            <span>Health &amp; Wellness Profile</span>
          </button>
          <button type="button" class="account-nav-item" data-tab="tab-consults">
            <span class="account-nav-icon">👨‍⚕️</span>
            <span>Doctor Consultations</span>
          </button>
        </nav>
      </aside>

      <div class="account-content-area">
        <!-- Orders Tab -->
        <div class="account-tab-pane is-active" id="tab-orders">
          <div class="account-pane-header">
            <h2 class="account-pane-title">Your Order History</h2>
            <p class="account-pane-desc">Track live shipments, download invoices, and reorder clinical formulations.</p>
          </div>

          {% paginate customer.orders by 10 %}
            {% if customer.orders.size > 0 %}
              {% for order in customer.orders %}
                <article class="order-card-card">
                  <div class="order-card-header">
                    <div class="order-id-block">
                      <span class="order-number">{{ order.name }}</span>
                      <span class="order-status-badge {% if order.fulfillment_status == 'fulfilled' %}delivered{% endif %}">
                        {{ order.fulfillment_status_label }}
                      </span>
                    </div>
                    <div class="order-meta-info">
                      <span>Placed on: <strong>{{ order.created_at | time_tag: format: 'date' }}</strong></span>
                    </div>
                  </div>

                  <div class="order-items-list">
                    {% for line_item in order.line_items %}
                      <div class="order-item-row">
                        <div class="order-item-left">
                          {% if line_item.image %}
                            <img src="{{ line_item.image | image_url: width: 112 }}" alt="{{ line_item.title }}" class="order-item-img" width="56" height="56" loading="lazy">
                          {% endif %}
                          <div>
                            <div class="order-item-title">{{ line_item.product.title }}</div>
                            <div class="order-item-variant">{{ line_item.variant.title }} &bull; Qty: {{ line_item.quantity }}</div>
                          </div>
                        </div>
                        <div class="order-item-price">{{ line_item.final_line_price | money }}</div>
                      </div>
                    {% endfor %}
                  </div>

                  <div class="order-actions-bar">
                    <div class="order-total-sum">Total: <strong>{{ order.total_price | money }}</strong></div>
                    <a href="{{ order.customer_url }}" class="btn btn-outline">View Order Details</a>
                  </div>
                </article>
              {% endfor %}
            {% else %}
              <div class="order-card-card" style="text-align:center; padding:3rem;">
                <p>You haven't placed any orders yet.</p>
                <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary" style="margin-top:1rem;">Explore Formulations</a>
              </div>
            {% endif %}
          {% endpaginate %}
        </div>

        <!-- Prescription Vault Tab -->
        <div class="account-tab-pane" id="tab-vault">
          <div class="account-pane-header">
            <h2 class="account-pane-title">Ayurvedic Prescription Vault</h2>
            <p class="account-pane-desc">Your verified Ayush medical prescriptions are securely stored here for seamless legal renewals and reorders.</p>
          </div>
          <div class="rx-vault-grid">
            <div class="rx-upload-dropzone">
              <div style="font-size:2.5rem; margin-bottom:0.75rem;">📄</div>
              <h3 style="font-family:var(--font-heading); font-size:1.25rem; color:var(--color-secondary); margin:0 0 0.35rem;">Upload New Prescription</h3>
              <p style="font-size:0.875rem; color:var(--color-text-secondary); margin:0 0 1rem;">PDF, JPEG, or PNG up to 15MB</p>
              <a href="{{ routes.root_url }}pages/contact" class="btn btn-primary">Submit to Medical Team</a>
            </div>
          </div>
        </div>

        <!-- Addresses Tab -->
        <div class="account-tab-pane" id="tab-addresses">
          <div class="account-pane-header" style="display:flex; justify-content:space-between; align-items:flex-end;">
            <div>
              <h2 class="account-pane-title">Saved Shipping Addresses</h2>
              <p class="account-pane-desc">Manage discreet shipping addresses for your clinical orders.</p>
            </div>
            <a href="{{ routes.account_addresses_url }}" class="btn btn-primary">Manage Addresses</a>
          </div>
          <div class="address-grid">
            {% if customer.default_address %}
              <div class="address-card is-default">
                <div class="address-name">
                  <span>{{ customer.default_address.name }}</span>
                  <span class="rx-status-pill">Primary Default</span>
                </div>
                <div class="address-lines">
                  {{ customer.default_address | format_address }}
                </div>
              </div>
            {% endif %}
          </div>
        </div>

        <!-- Health Profile Tab -->
        <div class="account-tab-pane" id="tab-health">
          <div class="account-pane-header">
            <h2 class="account-pane-title">Ayurvedic Health Profile</h2>
            <p class="account-pane-desc">Biological details to assist our Ayurvedic physicians during clinical consultations.</p>
          </div>
          <div class="order-card-card">
            <p>To update your clinical history or Ayurvedic wellness dossier, please consult our chief medical officer.</p>
            <a href="{{ routes.root_url }}pages/contact" class="btn btn-primary" style="margin-top:1rem;">Book Consultation</a>
          </div>
        </div>

        <!-- Consultations Tab -->
        <div class="account-tab-pane" id="tab-consults">
          <div class="account-pane-header" style="display:flex; justify-content:space-between; align-items:flex-end;">
            <div>
              <h2 class="account-pane-title">Physician Consultations</h2>
              <p class="account-pane-desc">Review clinical history, clinical evaluation notes, and schedule follow-ups.</p>
            </div>
            <a href="{{ routes.root_url }}pages/contact" class="btn btn-primary">Book Consultation</a>
          </div>
          <div class="order-card-card">
            <p>Complimentary Ayurvedic physician consultations are included with your prescriptions.</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const tabBtns = document.querySelectorAll('.account-nav-item');
  const tabPanes = document.querySelectorAll('.account-tab-pane');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', function () {
      const tabId = this.getAttribute('data-tab');
      if (!tabId) return;

      tabBtns.forEach(b => b.classList.remove('is-active'));
      tabPanes.forEach(p => p.classList.remove('is-active'));

      this.classList.add('is-active');
      const targetPane = document.getElementById(tabId);
      if (targetPane) targetPane.classList.add('is-active');
    });
  });
});
</script>

{% schema %}
{
  "name": "Customer Account",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 64
    }
  ]
}
{% endschema %}

