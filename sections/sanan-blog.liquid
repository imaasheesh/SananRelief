{% comment %}
  Sanan Blog Hub Section — Categories, Live Search, Featured Article, Responsive Grid & Pagination
{% endcomment %}

{{ 'storefront.css' | asset_url | stylesheet_tag }}

<section class="blog-hub-section section-{{ section.id }}-padding" id="Blog-{{ section.id }}">
  <div class="blog-hub-container">

    <!-- Header Hero -->
    <div class="blog-hub-header">
      <div class="blog-hub-eyebrow">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
        <span>{{ section.settings.eyebrow | default: 'THE SANAN JOURNAL • BOTANICAL SCIENCE' | escape }}</span>
      </div>
      <h1 class="blog-hub-title">{{ blog.title | default: section.settings.heading | default: 'Evidence-Led Ayurvedic Healing & Clinical Research' }}</h1>
      <p class="blog-hub-subtitle">{{ section.settings.subheading | default: 'Explore in-depth articles by Ayurvedic physicians, cannabinoid pharmacognosists, and holistic health practitioners.' | escape }}</p>
    </div>

    <!-- Category Filter Tabs & Live Search Toolbar -->
    <div class="blog-hub-toolbar">
      <div class="blog-cat-tabs" role="tablist">
        <button class="blog-tab-btn active" data-category="all" role="tab" aria-selected="true">All Insights</button>
        <button class="blog-tab-btn" data-category="pain" role="tab" aria-selected="false">Pain &amp; Mobility</button>
        <button class="blog-tab-btn" data-category="sleep" role="tab" aria-selected="false">Sleep &amp; Rest</button>
        <button class="blog-tab-btn" data-category="science" role="tab" aria-selected="false">Ayurvedic Science</button>
        <button class="blog-tab-btn" data-category="stress" role="tab" aria-selected="false">Stress &amp; Mind</button>
      </div>

      <div class="blog-search-box">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="BlogSearchInput" class="blog-search-input" placeholder="Search articles or topics..." aria-label="Search articles">
        <button type="button" id="BlogSearchClear" class="blog-search-clear" style="display: none;" aria-label="Clear search">&times;</button>
      </div>
    </div>

    <!-- Featured Lead Article Card -->
    <article class="blog-featured-card" data-category="science">
      <div class="blog-featured-media">
        <img src="{{ 'why-sanan-parallax-bg.jpg' | asset_url }}" alt="Whole-Plant Vijaya vs. Synthetic Isolates" class="blog-featured-img" width="700" height="420" loading="lazy">
        <span class="blog-card-badge">Featured Clinical Review</span>
      </div>
      <div class="blog-featured-content">
        <div class="blog-meta-top">
          <span class="blog-tag-pill">Ayurvedic Science</span>
          <span class="blog-read-time">6 min read</span>
          <span class="blog-pub-date">November 6, 2026</span>
        </div>
        <h2 class="blog-featured-heading">
          <a href="/pages/article">Whole-Plant Vijaya vs. Synthetic Isolates: Understanding the Entourage Effect</a>
        </h2>
        <p class="blog-featured-excerpt">
          Why single-molecule synthetic isolates fail to produce the nuanced therapeutic outcomes of whole-leaf Ayurvedic preparations. An in-depth clinical look at cannabinoid-terpene synergy and receptor affinity.
        </p>
        <div class="blog-author-row">
          <img src="{{ 'doctor-1.jpg' | asset_url }}" alt="Dr. Arvind Swaminathan" class="blog-author-avatar" width="44" height="44" loading="lazy">
          <div>
            <div class="blog-author-name">Dr. Arvind Swaminathan, MD (Ayu)</div>
            <div class="blog-author-role">Senior Ayurvedic Pharmacognosist</div>
          </div>
          <a href="/pages/article" class="btn-read-article">
            <span>Read Article</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>
    </article>

    <!-- 3-Column Article Cards Grid -->
    <div class="blog-grid" id="BlogGrid">

      <!-- Card 1: Pain -->
      <article class="blog-grid-card" data-category="pain">
        <div class="blog-card-thumb-wrap">
          <img src="{{ 'promo-banner-pain-relief.jpg' | asset_url }}" alt="Ayurvedic Management of Chronic Musculoskeletal Pain" class="blog-card-thumb" width="400" height="250" loading="lazy">
          <span class="blog-card-category">Pain &amp; Mobility</span>
        </div>
        <div class="blog-card-body">
          <div class="blog-card-meta-line">
            <span>5 min read</span>
            <span>•</span>
            <span>Oct 28, 2026</span>
          </div>
          <h3 class="blog-card-title">
            <a href="/pages/article">Ayurvedic Management of Chronic Musculoskeletal Pain: The Clinical Role of Vijaya</a>
          </h3>
          <p class="blog-card-desc">
            How transdermal salves and sublingual tinctures work together to downregulate localized inflammatory cytokines without gastric side effects.
          </p>
          <div class="blog-card-footer">
            <div class="blog-card-author">
              <img src="{{ 'doctor-2.jpg' | asset_url }}" alt="Dr. Rajeshwari Varma" class="blog-mini-avatar" width="32" height="32" loading="lazy">
              <span>Dr. Rajeshwari Varma</span>
            </div>
            <a href="/pages/article" class="blog-card-arrow" aria-label="Read article">&rarr;</a>
          </div>
        </div>
      </article>

      <!-- Card 2: Sleep -->
      <article class="blog-grid-card" data-category="sleep">
        <div class="blog-card-thumb-wrap">
          <img src="{{ 'cinematic-slide-2.svg' | asset_url }}" alt="Restoring Circadian Architecture Naturally" class="blog-card-thumb" width="400" height="250" loading="lazy">
          <span class="blog-card-category">Sleep &amp; Rest</span>
        </div>
        <div class="blog-card-body">
          <div class="blog-card-meta-line">
            <span>4 min read</span>
            <span>•</span>
            <span>Oct 22, 2026</span>
          </div>
          <h3 class="blog-card-title">
            <a href="/pages/article">Restoring Circadian Architecture Naturally: Why Botanical Synergy Outperforms Sedatives</a>
          </h3>
          <p class="blog-card-desc">
            Clinical sleep studies show botanical full-spectrum extracts improve NREM slow-wave sleep without next-morning cognitive fogginess.
          </p>
          <div class="blog-card-footer">
            <div class="blog-card-author">
              <img src="{{ 'doctor-4.jpg' | asset_url }}" alt="Dr. Ananya Sen Sharma" class="blog-mini-avatar" width="32" height="32" loading="lazy">
              <span>Dr. Ananya Sen</span>
            </div>
            <a href="/pages/article" class="blog-card-arrow" aria-label="Read article">&rarr;</a>
          </div>
        </div>
      </article>

      <!-- Card 3: Science -->
      <article class="blog-grid-card" data-category="science">
        <div class="blog-card-thumb-wrap">
          <img src="{{ 'cinematic-slide-1.svg' | asset_url }}" alt="How to Read a Third-Party Cannabinoid COA" class="blog-card-thumb" width="400" height="250" loading="lazy">
          <span class="blog-card-category">Ayurvedic Science</span>
        </div>
        <div class="blog-card-body">
          <div class="blog-card-meta-line">
            <span>7 min read</span>
            <span>•</span>
            <span>Oct 15, 2026</span>
          </div>
          <h3 class="blog-card-title">
            <a href="/pages/article">How to Read a Third-Party Cannabinoid COA: The Practitioner&rsquo;s Checklist</a>
          </h3>
          <p class="blog-card-desc">
            Learn how to verify chromatographic potency curves, terpene retention percentages, and safety thresholds for heavy metals and solvent residues.
          </p>
          <div class="blog-card-footer">
            <div class="blog-card-author">
              <img src="{{ 'doctor-3.jpg' | asset_url }}" alt="Dr. Nikhil Deoskar" class="blog-mini-avatar" width="32" height="32" loading="lazy">
              <span>Dr. Nikhil Deoskar</span>
            </div>
            <a href="/pages/article" class="blog-card-arrow" aria-label="Read article">&rarr;</a>
          </div>
        </div>
      </article>

      <!-- Card 4: Stress -->
      <article class="blog-grid-card" data-category="stress">
        <div class="blog-card-thumb-wrap">
          <img src="{{ 'benefit-stress-anxiety.jpg' | asset_url }}" alt="Vata Dosha & Autonomic Calming" class="blog-card-thumb" width="400" height="250" loading="lazy">
          <span class="blog-card-category">Stress &amp; Mind</span>
        </div>
        <div class="blog-card-body">
          <div class="blog-card-meta-line">
            <span>5 min read</span>
            <span>•</span>
            <span>Oct 08, 2026</span>
          </div>
          <h3 class="blog-card-title">
            <a href="/pages/article">Vata Dosha &amp; Autonomic Calming: Pairing Ashwagandha with Phytocannabinoids</a>
          </h3>
          <p class="blog-card-desc">
            How traditional Ayurvedic rasayana herbs combine with ECS agonists to lower cortisol spikes and support high-stress lifestyles.
          </p>
          <div class="blog-card-footer">
            <div class="blog-card-author">
              <img src="{{ 'doctor-1.jpg' | asset_url }}" alt="Dr. Arvind Swaminathan" class="blog-mini-avatar" width="32" height="32" loading="lazy">
              <span>Dr. Arvind Swaminathan</span>
            </div>
            <a href="/pages/article" class="blog-card-arrow" aria-label="Read article">&rarr;</a>
          </div>
        </div>
      </article>

      <!-- Card 5: Pain -->
      <article class="blog-grid-card" data-category="pain">
        <div class="blog-card-thumb-wrap">
          <img src="{{ 'cinematic-slide-4.svg' | asset_url }}" alt="Sports Recovery and Inflammation" class="blog-card-thumb" width="400" height="250" loading="lazy">
          <span class="blog-card-category">Pain &amp; Mobility</span>
        </div>
        <div class="blog-card-body">
          <div class="blog-card-meta-line">
            <span>4 min read</span>
            <span>•</span>
            <span>Sep 30, 2026</span>
          </div>
          <h3 class="blog-card-title">
            <a href="/pages/article">Targeting Post-Exercise DOMS: The Sports Medicine Case for Botanical Balms</a>
          </h3>
          <p class="blog-card-desc">
            Examining transdermal cannabinoid absorption in athletes experiencing chronic tendon and joint tension from endurance training.
          </p>
          <div class="blog-card-footer">
            <div class="blog-card-author">
              <img src="{{ 'doctor-2.jpg' | asset_url }}" alt="Dr. Rajeshwari Varma" class="blog-mini-avatar" width="32" height="32" loading="lazy">
              <span>Dr. Rajeshwari Varma</span>
            </div>
            <a href="/pages/article" class="blog-card-arrow" aria-label="Read article">&rarr;</a>
          </div>
        </div>
      </article>

      <!-- Card 6: Science -->
      <article class="blog-grid-card" data-category="science">
        <div class="blog-card-thumb-wrap">
          <img src="{{ 'cinematic-slide-3.svg' | asset_url }}" alt="Classical Ayurvedic Extraction Techniques" class="blog-card-thumb" width="400" height="250" loading="lazy">
          <span class="blog-card-category">Ayurvedic Science</span>
        </div>
        <div class="blog-card-body">
          <div class="blog-card-meta-line">
            <span>6 min read</span>
            <span>•</span>
            <span>Sep 21, 2026</span>
          </div>
          <h3 class="blog-card-title">
            <a href="/pages/article">Classical Shastra Purification (Shodhana) Meets Supercritical CO2 Extraction</a>
          </h3>
          <p class="blog-card-desc">
            A comprehensive look at how Sanan bridges 5,000-year-old purification rituals with modern pharmaceutical purity standards.
          </p>
          <div class="blog-card-footer">
            <div class="blog-card-author">
              <img src="{{ 'doctor-3.jpg' | asset_url }}" alt="Dr. Nikhil Deoskar" class="blog-mini-avatar" width="32" height="32" loading="lazy">
              <span>Dr. Nikhil Deoskar</span>
            </div>
            <a href="/pages/article" class="blog-card-arrow" aria-label="Read article">&rarr;</a>
          </div>
        </div>
      </article>

    </div>

    <!-- Pagination Controls (Matching User Request) -->
    <nav class="blog-pagination" aria-label="Blog Pagination">
      <button class="blog-page-btn blog-page-prev disabled" aria-disabled="true" aria-label="Previous Page">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <span>Previous</span>
      </button>

      <div class="blog-page-numbers">
        <button class="blog-page-num active" aria-current="page">1</button>
        <button class="blog-page-num">2</button>
        <button class="blog-page-num">3</button>
        <span class="blog-page-dots">&hellip;</span>
        <button class="blog-page-num">8</button>
      </div>

      <button class="blog-page-btn blog-page-next" aria-label="Next Page">
        <span>Next</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </nav>

  </div>
</section>

{% schema %}
{
  "name": "Blog Hub with Filters",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "THE SANAN JOURNAL • BOTANICAL SCIENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Evidence-Led Ayurvedic Healing & Clinical Research"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore in-depth articles by Ayurvedic physicians, cannabinoid pharmacognosists, and holistic health practitioners."
    }
  ],
  "presets": [
    {
      "name": "Sanan Blog Hub",
      "category": "Blog"
    }
  ]
}
{% endschema %}
