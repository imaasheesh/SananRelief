{% comment %}
  Sanan Legal Page Section — Complete with Horizontal Policy Subnavigation Bar
  Features horizontal tab bar right below header to toggle or navigate between:
  Privacy Policy | Terms of Service | Shipping & Delivery | Refund & Cancellation | Medical Disclaimer
{% endcomment %}

{{ 'storefront.css' | asset_url | stylesheet_tag }}

<section class="legal-page-section section-{{ section.id }}-padding" id="Legal-{{ section.id }}">
  <!-- Legal Hero Banner -->
  <div class="legal-hero">
    <div class="legal-hero-container">
      <div class="legal-eyebrow-pill">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        <span>{{ section.settings.eyebrow | default: 'LEGAL & AYUSH COMPLIANCE' | escape }}</span>
      </div>
      <h1 class="legal-hero-title">{{ page.title | default: section.settings.heading | default: 'Policies & Transparency' }}</h1>
      <p class="legal-hero-subtitle">Committed to ethical Ayurvedic formulation, consumer data privacy, and full AYUSH regulatory standards since 1985.</p>
      <div class="legal-meta-row">
        <span>Effective Date: November 1, 2026</span>
        <span>•</span>
        <span>License: AYUSH-DL-1985-01</span>
      </div>
    </div>
  </div>

  <!-- HORIZONTAL SUBNAV BAR RIGHT BELOW HEADER/HERO (Matching User Request) -->
  <nav class="legal-subnav-bar" aria-label="Legal Policies Navigation">
    <div class="legal-subnav-container">
      <ul class="legal-subnav-list">
        <li class="legal-subnav-item">
          <a href="#privacy" class="legal-subnav-link active" data-policy="privacy">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <span>Privacy Policy</span>
          </a>
        </li>
        <li class="legal-subnav-item">
          <a href="#terms" class="legal-subnav-link" data-policy="terms">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            <span>Terms of Service</span>
          </a>
        </li>
        <li class="legal-subnav-item">
          <a href="#shipping" class="legal-subnav-link" data-policy="shipping">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            <span>Shipping &amp; Delivery</span>
          </a>
        </li>
        <li class="legal-subnav-item">
          <a href="#refund" class="legal-subnav-link" data-policy="refund">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
            <span>Refund &amp; Return</span>
          </a>
        </li>
        <li class="legal-subnav-item">
          <a href="#disclaimer" class="legal-subnav-link" data-policy="disclaimer">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>Medical Disclaimer</span>
          </a>
        </li>
      </ul>

      <button class="btn-print-policy" onclick="window.print()" title="Print or save as PDF">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
        <span>Print Policy</span>
      </button>
    </div>
  </nav>

  <!-- Legal Main Content Card -->
  <div class="legal-content-container">
    <div class="legal-card">
      {%- if page.content != blank -%}
        <div class="legal-body-prose rte">
          {{ page.content }}
        </div>
      {%- else -%}
        <!-- Default Pre-built Editorial Legal Content Tab Sections -->
        <article class="legal-policy-pane active" id="pane-privacy">
          <h2 class="legal-section-title">Privacy Policy</h2>
          <p class="legal-lead-text">At Sanan Relief (operated under Sanan Ayurvedic Botanical Laboratories), we prioritize the confidentiality of our patients, doctors, and wellness seekers. This policy governs how we collect, store, and safeguard your health records and personal data.</p>
          
          <h3 class="legal-sub-title">1. Information We Collect</h3>
          <p>We collect essential order information including your name, delivery address, phone number, and optional health-related questionnaire data if you choose to consult our in-house Ayurvedic physicians for dosage guidance.</p>

          <h3 class="legal-sub-title">2. Doctor-Patient Confidentiality</h3>
          <p>Any medical history, formulation preferences, or clinical dosage inquiries shared with Sanan Relief are strictly confidential and stored under 256-bit AES encryption. We do not sell or monetize personal health data under any circumstances.</p>

          <h3 class="legal-sub-title">3. Cookies &amp; Storefront Analytics</h3>
          <p>We use session cookies to remember cart items, personalize dosage reminders, and analyze storefront performance. You can disable non-essential cookies via your browser settings at any time.</p>
        </article>

        <article class="legal-policy-pane" id="pane-terms">
          <h2 class="legal-section-title">Terms of Service</h2>
          <p class="legal-lead-text">Welcome to Sanan Relief. By accessing our platform and purchasing our proprietary Ayurvedic formulations, you agree to comply with the following terms and Indian statutory regulations under the Drugs and Cosmetics Act (1940).</p>

          <h3 class="legal-sub-title">1. Age Requirement &amp; Eligibility</h3>
          <p>You must be at least 18 years of age to purchase specialized Vijaya leaf extracts and proprietary herbal supplements on this website.</p>

          <h3 class="legal-sub-title">2. Prescription &amp; Ayurvedic Guidance</h3>
          <p>Certain Schedule E-1 botanical formulations require verification of an Ayurvedic prescription. Sanan Relief provides complimentary tele-consultations with certified BAMS physicians to facilitate appropriate dosage.</p>
        </article>

        <article class="legal-policy-pane" id="pane-shipping">
          <h2 class="legal-section-title">Shipping &amp; Delivery Policy</h2>
          <p class="legal-lead-text">We ship our certified Ayurvedic preparations across all serviceable PIN codes throughout India via express temperature-controlled logistics partners.</p>

          <h3 class="legal-sub-title">1. Dispatch &amp; Delivery Timelines</h3>
          <p>Orders are dispatched within 24–48 business hours from our GMP-certified facility in New Delhi. Typical metro delivery takes 2–4 business days; non-metro locations take 4–6 business days.</p>

          <h3 class="legal-sub-title">2. Discreet Packaging</h3>
          <p>To ensure patient confidentiality, all shipments arrive in neutral, tamper-evident outer packaging with no mention of specific botanical compounds on the external label.</p>
        </article>

        <article class="legal-policy-pane" id="pane-refund">
          <h2 class="legal-section-title">Refund &amp; Cancellation Policy</h2>
          <p class="legal-lead-text">Your satisfaction with our therapeutic formulations is our priority. Please review our return and refund guidelines below.</p>

          <h3 class="legal-sub-title">1. Damaged or Tampered Shipments</h3>
          <p>If your package arrives damaged, leaked, or tampered with, please email care@sananrelief.com within 48 hours with photographic evidence. We provide an immediate free replacement or 100% refund.</p>

          <h3 class="legal-sub-title">2. Formulation Safety</h3>
          <p>Due to hygiene and AYUSH pharmaceutical safety standards, opened bottles cannot be returned for restock unless deemed defective by our quality team.</p>
        </article>

        <article class="legal-policy-pane" id="pane-disclaimer">
          <h2 class="legal-section-title">AYUSH &amp; Medical Disclaimer</h2>
          <p class="legal-lead-text">Statements made regarding Sanan Relief formulations have not been evaluated by synthetic allopathic regulatory bodies; they are rooted in classical Ayurvedic pharmacology (Caraka Samhita, Sarngadhara Samhita) and licensed under the Ministry of AYUSH, Government of India.</p>

          <h3 class="legal-sub-title">1. Not a Substitute for Medical Advice</h3>
          <p>Our products are intended to support natural homeostasis, pain relief, and nervous system recovery. They are not intended to diagnose, cure, or prevent any acute clinical emergency without doctor supervision.</p>
        </article>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Legal Policy Hub",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "LEGAL & AYUSH COMPLIANCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page Title",
      "default": "Policies & Regulatory Transparency"
    }
  ],
  "presets": [
    {
      "name": "Sanan Legal Page",
      "category": "Page"
    }
  ]
}
{% endschema %}
