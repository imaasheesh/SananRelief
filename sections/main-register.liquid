{{ 'sanan-account.css' | asset_url | stylesheet_tag }}

<div class="sanan-account-wrapper" style="display:flex; align-items:center; justify-content:center; min-height:80vh;">
  <div style="width:100%; max-width:520px; padding:0 1.5rem;">
    <div style="background:rgba(255,255,255,0.9); backdrop-filter:blur(20px); border:1.5px solid var(--color-border); border-radius:24px; padding:3rem 2.5rem; box-shadow:0 20px 50px rgba(26,74,75,0.1);">
      <div style="text-align:center; margin-bottom:2.25rem;">
        <h1 style="font-family:var(--font-heading); font-size:2rem; color:var(--color-secondary); margin:0 0 0.45rem;">Patient Registration</h1>
        <p style="font-size:0.90625rem; color:var(--color-text-secondary); margin:0;">Create your Sanan Relief profile for personalized Ayush medical consultations.</p>
      </div>

      {% form 'create_customer' %}
        {{ form.errors | default_errors }}

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
          <div class="sanan-form-group">
            <label class="sanan-form-label" for="RegisterFirstName">First Name</label>
            <input type="text" name="customer[first_name]" id="RegisterFirstName" class="sanan-form-input" autocomplete="given-name" required>
          </div>
          <div class="sanan-form-group">
            <label class="sanan-form-label" for="RegisterLastName">Last Name</label>
            <input type="text" name="customer[last_name]" id="RegisterLastName" class="sanan-form-input" autocomplete="family-name" required>
          </div>
        </div>

        <div class="sanan-form-group">
          <label class="sanan-form-label" for="RegisterEmail">Email Address</label>
          <input type="email" name="customer[email]" id="RegisterEmail" class="sanan-form-input" autocomplete="email" required>
        </div>

        <div class="sanan-form-group">
          <label class="sanan-form-label" for="RegisterPassword">Password</label>
          <input type="password" name="customer[password]" id="RegisterPassword" class="sanan-form-input" autocomplete="new-password" required>
        </div>

        <div style="margin:1rem 0; font-size:0.8125rem; color:var(--color-text-secondary); line-height:1.4;">
          <label style="display:flex; align-items:flex-start; gap:0.5rem; cursor:pointer;">
            <input type="checkbox" required style="margin-top:3px;">
            <span>I confirm that I am 18+ years of age and agree to the <a href="{{ routes.root_url }}pages/legal" style="color:var(--color-primary-dark); font-weight:700;">Terms &amp; Medical Disclaimer</a>.</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%; height:50px; font-size:1rem; margin-top:0.75rem;">
          Create Patient Account &rarr;
        </button>
      {% endform %}

      <div style="text-align:center; margin-top:2rem; font-size:0.875rem; color:var(--color-text-secondary);">
        Already registered? <a href="{{ routes.account_login_url }}" style="color:var(--color-primary-dark); font-weight:700; text-decoration:underline;">Sign In here</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Register",
  "settings": []
}
{% endschema %}

