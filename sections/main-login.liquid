{{ 'sanan-account.css' | asset_url | stylesheet_tag }}

<div class="sanan-account-wrapper" style="display:flex; align-items:center; justify-content:center; min-height:80vh;">
  <div style="width:100%; max-width:480px; padding:0 1.5rem;">
    <div style="background:rgba(255,255,255,0.9); backdrop-filter:blur(20px); border:1.5px solid var(--color-border); border-radius:24px; padding:3rem 2.5rem; box-shadow:0 20px 50px rgba(26,74,75,0.1);">
      <div style="text-align:center; margin-bottom:2.25rem;">
        <h1 style="font-family:var(--font-heading); font-size:2rem; color:var(--color-secondary); margin:0 0 0.45rem;">Patient Portal</h1>
        <p style="font-size:0.90625rem; color:var(--color-text-secondary); margin:0;">Access your clinical orders, prescriptions, and physician evaluations.</p>
      </div>

      {% form 'customer_login' %}
        {{ form.errors | default_errors }}

        <div class="sanan-form-group">
          <label class="sanan-form-label" for="CustomerEmail">Email Address</label>
          <input type="email" name="customer[email]" id="CustomerEmail" class="sanan-form-input" autocomplete="email" autocorrect="off" autocapitalize="off" required>
        </div>

        {% if form.password_needed %}
          <div class="sanan-form-group">
            <div style="display:flex; justify-content:space-between; margin-bottom:0.45rem;">
              <label class="sanan-form-label" for="CustomerPassword" style="margin:0;">Password</label>
              <a href="#recover" id="RecoverPassword" style="font-size:0.8125rem; color:var(--color-primary-dark); text-decoration:underline;">Forgot?</a>
            </div>
            <input type="password" value="" name="customer[password]" id="CustomerPassword" class="sanan-form-input" autocomplete="current-password" required>
          </div>
        {% endif %}

        <button type="submit" class="btn btn-primary" style="width:100%; height:50px; font-size:1rem; margin-top:0.75rem;">
          Sign In to Portal &rarr;
        </button>
      {% endform %}

      <div style="display:flex; align-items:center; justify-content:center; gap:0.5rem; margin-top:1.75rem; padding:0.75rem; background:var(--color-primary-soft); border-radius:12px; font-size:0.78rem; font-weight:700; color:var(--color-primary-dark);">
        <span>🔒</span>
        <span>256-Bit Encrypted &bull; Ayush Medical Privacy Compliant</span>
      </div>

      <div style="text-align:center; margin-top:2rem; font-size:0.875rem; color:var(--color-text-secondary);">
        New patient? <a href="{{ routes.account_register_url }}" style="color:var(--color-primary-dark); font-weight:700; text-decoration:underline;">Create an account</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Login",
  "settings": []
}
{% endschema %}

