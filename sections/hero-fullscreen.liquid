{% comment %}
  Sanan Fullscreen Hero Image Section — Clean Fullscreen Hero Image (No Content)
  Features:
  - 100vh / Fullscreen edge-to-edge image banner
  - Zero horizontal overflow (width: 100%, max-width: 100%)
  - Clean responsive picture element supporting desktop & mobile image assets
  - Optional link on the image
  - Optional subtle Ken Burns ambient zoom
{% endcomment %}

{{ 'storefront.css' | asset_url | stylesheet_tag }}

<section
  class="hero-fullscreen-section height-{{ section.settings.hero_height | default: '100vh' | replace: '%', '' | replace: ' ', '' }} {% if section.settings.enable_zoom %}hero-fs-zoom-active{% endif %}"
  id="Hero-{{ section.id }}"
  data-section-type="hero-fullscreen"
>
  {%- if section.settings.link != blank -%}
    <a href="{{ section.settings.link }}" class="hero-fs-link" aria-label="{{ section.settings.image.alt | default: 'Hero banner' | escape }}">
  {%- endif -%}

    {%- if section.settings.image != blank -%}
      <picture class="hero-fs-picture">
        {%- if section.settings.mobile_image != blank -%}
          <source media="(max-width: 768px)" srcset="{{ section.settings.mobile_image | image_url: width: 1080 }}">
        {%- endif -%}
        <img
          src="{{ section.settings.image | image_url: width: 2400 }}"
          srcset="{{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1800 }} 1800w, {{ section.settings.image | image_url: width: 2400 }} 2400w"
          sizes="100vw"
          alt="{{ section.settings.image.alt | default: 'Sanan Relief' | escape }}"
          class="hero-fs-img"
          width="2400"
          height="1350"
          loading="eager"
          fetchpriority="high"
        >
      </picture>
    {%- else -%}
      <img
        src="{{ 'hero-fullscreen-bg.jpg' | asset_url }}"
        alt="Sanan Relief"
        class="hero-fs-img"
        width="2400"
        height="1350"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}

  {%- if section.settings.link != blank -%}
    </a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero Fullscreen Image",
  "tag": "section",
  "class": "section-hero-fullscreen",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image",
      "info": "High-resolution desktop image (recommended 2400 x 1350px or higher)."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image (Optional)",
      "info": "Mobile portrait image (recommended 1080 x 1440px)."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Image Link (Optional)"
    },
    {
      "type": "select",
      "id": "hero_height",
      "label": "Section Height",
      "options": [
        { "value": "100vh", "label": "Full Screen (100vh)" },
        { "value": "90vh", "label": "90% Screen Height" },
        { "value": "80vh", "label": "80% Screen Height" },
        { "value": "auto", "label": "Adapt to Image Aspect Ratio" }
      ],
      "default": "100vh"
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Enable Subtle Ken Burns Ambient Zoom",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Hero Fullscreen Image",
      "settings": {
        "hero_height": "100vh",
        "enable_zoom": false
      }
    }
  ]
}
{% endschema %}
