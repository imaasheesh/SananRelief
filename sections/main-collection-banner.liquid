{{ 'sanan-collection.css' | asset_url | stylesheet_tag }}

<!-- 1. FULL WIDTH 450PX HERO IMAGE (FROM TOP OF PAGE) -->
<div class="sanan-collection-hero-banner" role="banner" aria-label="{{ collection.title | escape }}">
  {%- if collection.image -%}
    {{
      collection.image
      | image_url: width: 2400
      | image_tag:
        class: 'sanan-hero-banner-img',
        loading: 'eager',
        widths: '750, 1100, 1500, 1780, 2000, 2400',
        alt: collection.title
    }}
  {%- else -%}
    <img
      src="{{ 'hero-fullscreen-bg.jpg' | asset_url }}"
      alt="{{ collection.title | escape }}"
      class="sanan-hero-banner-img"
      width="2400"
      height="450"
      loading="eager"
    >
  {%- endif -%}
  <div class="sanan-hero-banner-overlay"></div>
</div>

<!-- 2. BREADCRUMBS & HEALTH CONCERNS (BELOW 450PX HERO BANNER) -->
<div class="sanan-collection-breadcrumbs-bar">
  <div class="sanan-container">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="sanan-breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="sanan-breadcrumbs-separator">&rsaquo;</span>
        <a href="{{ routes.all_products_collection_url }}">Shop</a>
        <span class="sanan-breadcrumbs-separator">&rsaquo;</span>
        <span class="sanan-breadcrumbs-current">{{ collection.title | escape }}</span>
      </nav>
    {%- endif -%}

    <!-- Visual Health Concern Scrolling Filter Tabs (Editorial Luxury Carousel) -->
    {%- if section.settings.show_concern_pills -%}
      <div class="sanan-concern-scroller-container">
        <button type="button" class="sanan-tab-scroll-btn sanan-tab-scroll-prev" id="ConcernScrollPrev" aria-label="Scroll tabs left">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
        </button>

        <div class="sanan-concern-tabs-track" id="SananConcernFilterPills" role="tablist" aria-label="Filter by Health Concern">
          <!-- All Formulations -->
          <button type="button" class="sanan-concern-tab is-active" data-concern="all" role="tab" aria-selected="true">
            <div class="sanan-tab-thumb-wrap">
              <img src="{{ 'product-vijaya-oil.svg' | asset_url }}" alt="All Formulations" class="sanan-tab-thumb" width="70" height="70" loading="eager">
            </div>
            <span class="sanan-tab-title">All Formulations</span>
            <span class="sanan-tab-count" id="ConcernCountAll">({{ collection.all_products_count | default: 12 }})</span>
            <span class="sanan-tab-active-dot"></span>
          </button>

          <!-- Pain & Muscle Recovery -->
          <button type="button" class="sanan-concern-tab" data-concern="pain" role="tab" aria-selected="false">
            <div class="sanan-tab-thumb-wrap">
              <img src="{{ 'benefit-pain-relief.svg' | asset_url }}" alt="Pain &amp; Muscle Recovery" class="sanan-tab-thumb" width="70" height="70" loading="lazy">
            </div>
            <span class="sanan-tab-title">Pain &amp; Muscle</span>
            <span class="sanan-tab-count">(6)</span>
            <span class="sanan-tab-active-dot"></span>
          </button>

          <!-- Stress & Anxiety -->
          <button type="button" class="sanan-concern-tab" data-concern="stress" role="tab" aria-selected="false">
            <div class="sanan-tab-thumb-wrap">
              <img src="{{ 'benefit-stress-anxiety.jpg' | asset_url }}" alt="Stress &amp; Anxiety" class="sanan-tab-thumb" width="70" height="70" loading="lazy">
            </div>
            <span class="sanan-tab-title">Stress &amp; Mood</span>
            <span class="sanan-tab-count">(3)</span>
            <span class="sanan-tab-active-dot"></span>
          </button>

          <!-- Sleep Management -->
          <button type="button" class="sanan-concern-tab" data-concern="sleep" role="tab" aria-selected="false">
            <div class="sanan-tab-thumb-wrap">
              <img src="{{ 'benefit-sleep-recovery.svg' | asset_url }}" alt="Sleep Management" class="sanan-tab-thumb" width="70" height="70" loading="lazy">
            </div>
            <span class="sanan-tab-title">Sleep &amp; Rest</span>
            <span class="sanan-tab-count">(3)</span>
            <span class="sanan-tab-active-dot"></span>
          </button>

          <!-- Daily Wellness & Metabolism -->
          <button type="button" class="sanan-concern-tab" data-concern="wellness" role="tab" aria-selected="false">
            <div class="sanan-tab-thumb-wrap">
              <img src="{{ 'product-radiance-serum.svg' | asset_url }}" alt="Daily Wellness &amp; Metabolism" class="sanan-tab-thumb" width="70" height="70" loading="lazy">
            </div>
            <span class="sanan-tab-title">Daily Wellness</span>
            <span class="sanan-tab-count">(3)</span>
            <span class="sanan-tab-active-dot"></span>
          </button>

          <!-- Unwind & Relax -->
          <button type="button" class="sanan-concern-tab" data-concern="relax" role="tab" aria-selected="false">
            <div class="sanan-tab-thumb-wrap">
              <img src="{{ 'product-sleepwell-pulse.svg' | asset_url }}" alt="Unwind and Relax" class="sanan-tab-thumb" width="70" height="70" loading="lazy">
            </div>
            <span class="sanan-tab-title">Unwind &amp; Calm</span>
            <span class="sanan-tab-count">(2)</span>
            <span class="sanan-tab-active-dot"></span>
          </button>

          <!-- Cancer Care & Appetite -->
          <button type="button" class="sanan-concern-tab" data-concern="cancer" role="tab" aria-selected="false">
            <div class="sanan-tab-thumb-wrap">
              <img src="{{ 'cta-product-3d.png' | asset_url }}" alt="Cancer Care &amp; Appetite" class="sanan-tab-thumb" width="70" height="70" loading="lazy">
            </div>
            <span class="sanan-tab-title">Cancer Palliative</span>
            <span class="sanan-tab-count">(2)</span>
            <span class="sanan-tab-active-dot"></span>
          </button>

          <!-- Mental Focus & ADHD -->
          <button type="button" class="sanan-concern-tab" data-concern="mental-health" role="tab" aria-selected="false">
            <div class="sanan-tab-thumb-wrap">
              <img src="{{ 'product-ashwagandha.svg' | asset_url }}" alt="Mental Health &amp; Focus" class="sanan-tab-thumb" width="70" height="70" loading="lazy">
            </div>
            <span class="sanan-tab-title">Mental Focus</span>
            <span class="sanan-tab-count">(2)</span>
            <span class="sanan-tab-active-dot"></span>
          </button>

          <!-- Joints & Mobility -->
          <button type="button" class="sanan-concern-tab" data-concern="joints" role="tab" aria-selected="false">
            <div class="sanan-tab-thumb-wrap">
              <img src="{{ 'product-herbal-balm.svg' | asset_url }}" alt="Joints &amp; Mobility" class="sanan-tab-thumb" width="70" height="70" loading="lazy">
            </div>
            <span class="sanan-tab-title">Joints &amp; Mobility</span>
            <span class="sanan-tab-count">(2)</span>
            <span class="sanan-tab-active-dot"></span>
          </button>
        </div>

        <button type="button" class="sanan-tab-scroll-btn sanan-tab-scroll-next" id="ConcernScrollNext" aria-label="Scroll tabs right">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Sanan Collection Header",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show Breadcrumbs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show Collection Description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Show Trust Badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_concern_pills",
      "label": "Show Health Concern Quick Pills",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
