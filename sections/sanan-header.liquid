      <!-- Card 3 -->
      <a href="{{ routes.all_products_collection_url }}#sleep" class="sso-concern-card">
        <div class="sso-concern-img-wrap">
          <img src="{{ 'benefit-sleep-recovery.svg' | asset_url }}" alt="Sleep Management" class="sso-concern-img" width="220" height="135" loading="lazy">
        </div>
        <h4 class="sso-concern-title">Sleep Management</h4>
      </a>

      <!-- Card 4 -->
      <a href="{{ routes.all_products_collection_url }}#daily" class="sso-concern-card">
        <div class="sso-concern-img-wrap">
          <img src="{{ 'product-radiance-serum.svg' | asset_url }}" alt="Daily Wellness &amp; Metabolism" class="sso-concern-img" width="220" height="135" loading="lazy">
        </div>
        <h4 class="sso-concern-title">Daily Wellness &amp; Metabolism</h4>
      </a>

      <!-- Card 5 -->
      <a href="{{ routes.all_products_collection_url }}#relax" class="sso-concern-card">
        <div class="sso-concern-img-wrap">
          <img src="{{ 'product-sleepwell-pulse.svg' | asset_url }}" alt="Unwind and Relax" class="sso-concern-img" width="220" height="135" loading="lazy">
        </div>
        <h4 class="sso-concern-title">Unwind and Relax</h4>
      </a>

      <!-- Card 6 -->
      <a href="{{ routes.all_products_collection_url }}#cancer-care" class="sso-concern-card">
        <div class="sso-concern-img-wrap">
          <img src="{{ 'cta-product-3d.png' | asset_url }}" alt="Cancer Care &amp; Palliative" class="sso-concern-img" width="220" height="135" loading="lazy">
        </div>
        <h4 class="sso-concern-title">Cancer Care &amp; Palliative</h4>
