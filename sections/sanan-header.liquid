        <span>Concern Combos</span>
        <span>&rarr;</span>
      </button>
      <button type="button" class="sso-tab-btn" data-tab="all-products">
        <span>All 24+ Products</span>
        <span>&rarr;</span>
      </button>
    </aside>

    <!-- TAB 1: 4x2 Visual Cards Grid (From Image 3 Reference) -->
    <div class="sso-tab-pane sso-cards-grid is-active" id="SsoTab-concerns">
      <!-- Card 1 -->
      <a href="{{ routes.all_products_collection_url }}#pain" class="sso-concern-card">
        <div class="sso-concern-img-wrap">
          <img src="{{ 'benefit-pain-relief.svg' | asset_url }}" alt="Pain &amp; Muscle Recovery" class="sso-concern-img" width="220" height="135" loading="lazy">
