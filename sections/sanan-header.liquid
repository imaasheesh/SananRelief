<script>
  (function () {
    // 1. Full Screen Overlay for Shop Link
    const overlay = document.getElementById('SananShopAllOverlay');
    const shopTriggers = document.querySelectorAll('.sanan-shop-trigger');
    const closeBtn = document.getElementById('SananOverlayCloseBtn');

    function openOverlay() {
      if (!overlay) return;
      overlay.classList.add('is-active');
      document.body.classList.add('sanan-overlay-open');
    }

    function closeOverlay() {
      if (!overlay) return;
      overlay.classList.remove('is-active');
      document.body.classList.remove('sanan-overlay-open');
    }

    shopTriggers.forEach(trig => {
      trig.addEventListener('click', function (e) {
        e.preventDefault();
        openOverlay();
      });
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', closeOverlay);
    }

    // Close on Escape Key
    window.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay && overlay.classList.contains('is-active')) {
        closeOverlay();
      }
    });

    // Close when clicking outside content container
    if (overlay) {
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) {
          closeOverlay();
        }
      });
    }

    // Tab Switching inside Full Screen Overlay
    const tabBtns = overlay ? overlay.querySelectorAll('.sso-tab-btn') : [];
    const tabPanes = overlay ? overlay.querySelectorAll('.sso-tab-pane') : [];

    tabBtns.forEach(btn => {
      btn.addEventListener('click', function () {
        const target = this.getAttribute('data-tab');
        tabBtns.forEach(b => b.classList.remove('is-active'));
        this.classList.add('is-active');

        tabPanes.forEach(pane => {
          if (pane.id === 'SsoTab-' + target) {
            pane.style.display = 'grid';
          } else {
            pane.style.display = 'none';
          }
        });
      });
    });

    // 2. Flicker-Free Full-Width Viewport Mega Menus Controller
    const megaTriggers = document.querySelectorAll('.sanan-mega-trigger');
    const megaMenus = document.querySelectorAll('.sanan-mega-menu');
    const headerCard = document.querySelector('.sanan-header-card');
    let megaTimeout = null;
    let pinnedMega = null; // Stays open when clicked

    function showMega(targetId) {
      clearTimeout(megaTimeout);
      const targetMenu = document.getElementById(targetId);
      megaMenus.forEach(m => {
        if (m !== targetMenu) {
          m.classList.remove('is-active');
        }
      });
      megaTriggers.forEach(t => {
        if (t.getAttribute('data-mega-target') === targetId) {
          t.classList.add('is-active');
        } else {
          t.classList.remove('is-active');
        }
      });
      if (targetMenu) {
        targetMenu.classList.add('is-active');
      }
    }

    function hideMega(immediate = false) {
      clearTimeout(megaTimeout);
      if (immediate) {
        megaMenus.forEach(m => m.classList.remove('is-active'));
        megaTriggers.forEach(t => t.classList.remove('is-active'));
        pinnedMega = null;
        return;
      }
      // Generous 380ms debounce so cursor glides down smoothly without disappearing
      megaTimeout = setTimeout(() => {
        if (!pinnedMega) {
          megaMenus.forEach(m => m.classList.remove('is-active'));
          megaTriggers.forEach(t => t.classList.remove('is-active'));
        }
      }, 380);
    }

    // Hover triggers with generous buffer
    megaTriggers.forEach(trig => {
      const targetId = trig.getAttribute('data-mega-target');

      trig.addEventListener('mouseenter', () => {
        pinnedMega = null;
        showMega(targetId);
      });

      trig.addEventListener('mouseleave', () => {
        hideMega(false);
      });

      trig.addEventListener('focus', () => {
        showMega(targetId);
      });

      // Click to pin / toggle open
      trig.addEventListener('click', (e) => {
        e.preventDefault();
        const targetMenu = document.getElementById(targetId);
        if (targetMenu && targetMenu.classList.contains('is-active') && pinnedMega === targetId) {
          hideMega(true);
        } else {
          pinnedMega = targetId;
          showMega(targetId);
        }
      });
    });

    // Keep open while cursor is hovering inside the mega menu
    megaMenus.forEach(menu => {
      menu.addEventListener('mouseenter', () => {
        clearTimeout(megaTimeout);
      });
      menu.addEventListener('mouseleave', () => {
        hideMega(false);
      });
    });

    // Keep open while cursor is moving across the header card
    if (headerCard) {
      headerCard.addEventListener('mouseenter', () => {
        clearTimeout(megaTimeout);
      });
      headerCard.addEventListener('mouseleave', () => {
        hideMega(false);
      });
    }

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.sanan-floating-header') && !e.target.closest('.sanan-mega-menu')) {
        hideMega(true);
      }
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        hideMega(true);
      }
    });
  })();
</script>

