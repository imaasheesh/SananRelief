{% comment %}
  Renders an inline SVG icon from the theme icon library.
  
  Usage:
    {% render 'icon', name: 'cart', size: 24, class: 'icon-cart' %}

  Parameters:
    name  {String} - Icon name (required). See list below.
    size  {Number} - Width & height in px. Default: 24.
    class {String} - Additional CSS class(es). Default: ''.

  Available icons:
    — Navigation:  menu, x, chevron-down, chevron-right, chevron-left, arrow-right, arrow-left
    — Commerce:    cart, cart-plus, heart, heart-filled, search, user, bag
    — UI:          check, check-circle, info, alert-triangle, alert-circle, star, star-filled
    — Media:       play, pause, volume-2, volume-x, zoom-in, image, video
    — Actions:     plus, minus, trash, edit, share, copy, download, external-link
    — Brand:       leaf, shield-check, truck, package, refresh-cw, clock
    — Social:      instagram, facebook, twitter-x, youtube, tiktok, pinterest, whatsapp
    — Misc:        globe, mail, phone, map-pin, lock, unlock, eye, eye-off, filter, sliders
{% endcomment %}

{%- assign icon_size = size | default: 24 -%}
{%- assign icon_class = class | default: '' -%}

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class="icon icon-{{ name }}{% if icon_class != '' %} {{ icon_class }}{% endif %}"
>
  {%- case name -%}

    {%- comment -%}── NAVIGATION ──{%- endcomment -%}

    {%- when 'menu' -%}
      <line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/>

    {%- when 'x' -%}
      <path d="M18 6 6 18"/><path d="m6 6 12 12"/>

    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>

    {%- when 'chevron-up' -%}
      <path d="m18 15-6-6-6 6"/>

    {%- when 'chevron-right' -%}
      <path d="m9 18 6-6-6-6"/>

    {%- when 'chevron-left' -%}
      <path d="m15 18-6-6 6-6"/>

    {%- when 'arrow-right' -%}
      <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>

    {%- when 'arrow-left' -%}
      <path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>

    {%- when 'arrow-up' -%}
      <path d="M12 19V5"/><path d="m5 12 7-7 7 7"/>

    {%- when 'arrow-up-right' -%}
      <path d="M7 7h10v10"/><path d="M7 17 17 7"/>

    {%- comment -%}── COMMERCE ──{%- endcomment -%}

    {%- when 'cart' -%}
      <circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>

    {%- when 'cart-plus' -%}
      <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" x2="21" y1="6" y2="6"/><path d="M12 11v6"/><path d="M9 14h6"/>

    {%- when 'bag' -%}
      <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" x2="21" y1="6" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>

    {%- when 'heart' -%}
      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>

    {%- when 'heart-filled' -%}
      <path fill="currentColor" stroke="none" d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>

    {%- when 'search' -%}
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>

    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 0 0-16 0"/>

    {%- when 'user-circle' -%}
      <circle cx="12" cy="12" r="10"/><circle cx="12" cy="10" r="3"/><path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662"/>

    {%- comment -%}── UI ──{%- endcomment -%}

    {%- when 'check' -%}
      <path d="M20 6 9 17l-5-5"/>

    {%- when 'check-circle' -%}
      <circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>

    {%- when 'info' -%}
      <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>

    {%- when 'alert-triangle' -%}
      <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>

    {%- when 'alert-circle' -%}
      <circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/>

    {%- when 'star' -%}
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>

    {%- when 'star-filled' -%}
      <polygon fill="currentColor" stroke="none" points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>

    {%- comment -%}── MEDIA ──{%- endcomment -%}

    {%- when 'play' -%}
      <polygon points="6 3 20 12 6 21 6 3"/>

    {%- when 'play-circle' -%}
      <circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/>

    {%- when 'pause' -%}
      <rect width="4" height="16" x="6" y="4"/><rect width="4" height="16" x="14" y="4"/>

    {%- when 'volume-2' -%}
      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>

    {%- when 'volume-x' -%}
      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="22" x2="16" y1="9" y2="15"/><line x1="16" x2="22" y1="9" y2="15"/>

    {%- when 'zoom-in' -%}
      <circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/><line x1="11" x2="11" y1="8" y2="14"/><line x1="8" x2="14" y1="11" y2="11"/>

    {%- when 'image' -%}
      <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>

    {%- when 'video' -%}
      <path d="m22 8-6 4 6 4V8z"/><rect height="12" rx="2" ry="2" width="14" x="2" y="6"/>

    {%- comment -%}── ACTIONS ──{%- endcomment -%}

    {%- when 'plus' -%}
      <path d="M5 12h14"/><path d="M12 5v14"/>

    {%- when 'minus' -%}
      <path d="M5 12h14"/>

    {%- when 'trash' -%}
      <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>

    {%- when 'edit' -%}
      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>

    {%- when 'share' -%}
      <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>

    {%- when 'copy' -%}
      <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>

    {%- when 'download' -%}
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>

    {%- when 'external-link' -%}
      <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>

    {%- comment -%}── BRAND / COMMERCE ──{%- endcomment -%}

    {%- when 'leaf' -%}
      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>

    {%- when 'shield-check' -%}
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/>

    {%- when 'truck' -%}
      <path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/><polygon points="9 17 20 17 23 11 14 11 9 17"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="17.5" cy="17.5" r="1.5"/>

    {%- when 'package' -%}
      <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><path d="m3.3 7 7.703 4.734a2 2 0 0 0 1.994 0L20.7 7"/><path d="m7.5 4.27 9 5.15"/>

    {%- when 'refresh-cw' -%}
      <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>

    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>

    {%- when 'gift' -%}
      <rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/>

    {%- when 'tag' -%}
      <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/>

    {%- when 'percent' -%}
      <line x1="19" x2="5" y1="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/>

    {%- comment -%}── SOCIAL ──{%- endcomment -%}

    {%- when 'instagram' -%}
      <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>

    {%- when 'facebook' -%}
      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>

    {%- when 'twitter-x' -%}
      <path d="M4 4l11.733 16H20L8.267 4z"/><path d="M4 20l6.768-6.768M20 4l-6.768 6.768"/>

    {%- when 'youtube' -%}
      <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><polygon points="10 15 15 12 10 9 10 15"/>

    {%- when 'tiktok' -%}
      <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>

    {%- when 'pinterest' -%}
      <line x1="12" x2="12" y1="17" y2="22"/><path d="M17.34 15a7 7 0 1 0-12.56-4.17c.14 2.1 1.4 3.76 2.3 5.17h5.84"/><path d="m9.1 11.1 5.8-5.8"/>

    {%- when 'whatsapp' -%}
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>

    {%- comment -%}── MISC ──{%- endcomment -%}

    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="10"/><line x1="2" x2="22" y1="12" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>

    {%- when 'mail' -%}
      <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>

    {%- when 'phone' -%}
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.07 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 17z"/>

    {%- when 'map-pin' -%}
      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>

    {%- when 'lock' -%}
      <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>

    {%- when 'unlock' -%}
      <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/>

    {%- when 'eye' -%}
      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>

    {%- when 'eye-off' -%}
      <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/>

    {%- when 'filter' -%}
      <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>

    {%- when 'sliders' -%}
      <line x1="4" x2="4" y1="21" y2="14"/><line x1="4" x2="4" y1="6" y2="3"/><line x1="12" x2="12" y1="21" y2="13"/><line x1="12" x2="12" y1="5" y2="3"/><line x1="20" x2="20" y1="21" y2="17"/><line x1="20" x2="20" y1="9" y2="3"/><line x1="1" x2="7" y1="14" y2="14"/><line x1="9" x2="15" y1="8" y2="8"/><line x1="17" x2="23" y1="17" y2="17"/>

    {%- when 'grid' -%}
      <rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/>

    {%- when 'list' -%}
      <line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/>

    {%- when 'loader' -%}
      <line x1="12" x2="12" y1="2" y2="6"/><line x1="12" x2="12" y1="18" y2="22"/><line x1="4.93" x2="7.76" y1="4.93" y2="7.76"/><line x1="16.24" x2="19.07" y1="16.24" y2="19.07"/><line x1="2" x2="6" y1="12" y2="12"/><line x1="18" x2="22" y1="12" y2="12"/><line x1="4.93" x2="7.76" y1="19.07" y2="16.24"/><line x1="16.24" x2="19.07" y1="7.76" y2="4.93"/>

    {%- when 'sparkles' -%}
      <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/>

    {%- else -%}
      {%- comment -%} Fallback: empty square if icon not found {%- endcomment -%}
      <rect width="18" height="18" x="3" y="3" rx="2" stroke-dasharray="4 2"/>

  {%- endcase -%}
</svg>

