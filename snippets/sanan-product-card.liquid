{% comment %}
  Renders a premium Sanan Relief product card.

  Accepts:
  - product: {Object} Product object (required)
  - show_secondary_image: {Boolean} Show secondary image on hover (default: true)
  - show_vendor: {Boolean} Show vendor/type (default: true)
  - show_rating: {Boolean} Show star rating (default: true)
  - show_badge: {Boolean} Show product badge (default: true)
  - lazy_load: {Boolean} Lazy load image (default: true)
  - section_id: {String} Section ID
{% endcomment %}

{%- liquid
  assign featured_media = product.featured_media
  assign secondary_media = product.media[1]
  assign current_variant = product.selected_or_first_available_variant
  assign has_variants = false
  if product.variants.size > 1
    assign has_variants = true
  endif

  assign is_sold_out = true
  if current_variant.available
    assign is_sold_out = false
  endif

  assign has_discount = false
  if current_variant.compare_at_price > current_variant.price
    assign has_discount = true
    assign discount_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif
-%}

<div
  class="sanan-card-wrapper"
  data-product-id="{{ product.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-has-variants="{{ has_variants }}"
  {% if has_variants %}
    data-variants-json='[
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "title": {{ variant.title | json }},
          "price": {{ variant.price | money | json }},
          "available": {{ variant.available | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]'
  {% endif %}
>
  <div class="sanan-product-card">
    <!-- Media Section -->
    <div class="sanan-card-media {% if is_sold_out %}is-sold-out{% endif %}">
      <!-- Badges -->
      {%- if show_badge != false -%}
        <div class="sanan-badge-group">
          {%- if is_sold_out -%}
            <span class="sanan-badge-pill">Sold Out</span>
          {%- elsif has_discount -%}
            <span class="sanan-badge-pill badge--sale">-{{ discount_percent }}% OFF</span>
          {%- elsif product.tags contains 'Bestseller' or product.tags contains 'bestseller' -%}
            <span class="sanan-badge-pill badge--bestseller">Bestseller</span>
          {%- elsif product.tags contains 'New' or product.tags contains 'new' -%}
            <span class="sanan-badge-pill badge--new">New</span>
          {%- else -%}
            <span class="sanan-badge-pill">Ayush Certified</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <!-- Wishlist Button -->
      <button type="button" class="sanan-wishlist-btn" title="Add to Wishlist" aria-label="Add to Wishlist">
        <svg viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
      </button>

      <!-- Product Photography -->
      <a href="{{ product.url }}" class="sanan-card-link-wrap" style="display:contents;">
        {%- if featured_media -%}
          <img
            src="{{ featured_media | image_url: width: 600 }}"
            srcset="
              {{ featured_media | image_url: width: 360 }} 360w,
              {{ featured_media | image_url: width: 540 }} 540w,
              {{ featured_media | image_url: width: 720 }} 720w
            "
            sizes="(min-width: 1200px) 25vw, (min-width: 768px) 33vw, 50vw"
            alt="{{ featured_media.alt | default: product.title | escape }}"
            class="sanan-card-img-primary"
            {% if lazy_load != false %}loading="lazy"{% endif %}
            width="{{ featured_media.width }}"
            height="{{ featured_media.height }}"
          >
          {%- if secondary_media and show_secondary_image != false -%}
            <img
              src="{{ secondary_media | image_url: width: 600 }}"
              srcset="
                {{ secondary_media | image_url: width: 360 }} 360w,
                {{ secondary_media | image_url: width: 540 }} 540w,
                {{ secondary_media | image_url: width: 720 }} 720w
              "
              sizes="(min-width: 1200px) 25vw, (min-width: 768px) 33vw, 50vw"
              alt="{{ secondary_media.alt | default: product.title | escape }}"
              class="sanan-card-img-secondary"
              loading="lazy"
              width="{{ secondary_media.width }}"
              height="{{ secondary_media.height }}"
            >
          {%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'sanan-card-img-primary' }}
        {%- endif -%}
      </a>

      <!-- Quick View Pill -->
      <button type="button" class="sanan-quickview-btn sanan-quick-add-btn" title="Quick View &amp; Select" aria-label="Quick View">
        <div class="qv-circle">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
        </div>
        <div class="qv-text">Quick Add</div>
      </button>

      <!-- Botanical Ingredients Overlay -->
      <div class="sanan-ingredients-overlay">
        <div class="sanan-ingredient-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 0 1 10 10c0 5.5-4.5 10-10 10S2 17.5 2 12A10 10 0 0 1 12 2Z"/></svg>
          <span>Vijaya Extract</span>
        </div>
        <div class="sanan-ingredient-sep"></div>
        <div class="sanan-ingredient-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <span>Full Spectrum</span>
        </div>
      </div>
    </div>

    <!-- Product Info Section -->
    <div class="sanan-card-info">
      <div class="sanan-card-type-row">
        <span class="sanan-card-type">{{ product.type | default: 'Ayurvedic Formulation' }}</span>
        {%- if show_rating != false -%}
          <div class="sanan-card-rating">
            <span class="stars">★★★★★</span>
            <span class="score">4.9</span>
          </div>
        {%- endif -%}
      </div>

      <a href="{{ product.url }}" class="sanan-card-title">{{ product.title }}</a>

      <div class="sanan-card-concern">
        {%- if product.metafields.custom.health_concern -%}
          {{ product.metafields.custom.health_concern }}
        {%- else -%}
          Targeted Ayurvedic Botanical Support
        {%- endif -%}
      </div>

      <!-- Price Row -->
      <div class="sanan-card-price-row">
        <span class="sanan-card-price">{{ current_variant.price | money }}</span>
        {%- if has_discount -%}
          <span class="sanan-card-compare-price">{{ current_variant.compare_at_price | money }}</span>
          <span class="sanan-card-save-badge">Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}</span>
        {%- endif -%}
      </div>
    </div>

    <!-- Organic Scoop Notch -->
    <div class="sanan-card-notch"></div>
  </div>

  <!-- Floating External Cart Action Button -->
  <button
    type="button"
    class="sanan-external-cart-btn btn-add-to-cart"
    title="{% if is_sold_out %}Sold Out{% elsif has_variants %}Select Options{% else %}Add to Cart{% endif %}"
    aria-label="Add {{ product.title | escape }} to Cart"
    {% if is_sold_out %}disabled{% endif %}
  >
    {%- if is_sold_out -%}
      <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    {%- elsif has_variants -%}
      <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
    {%- else -%}
      <svg viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
    {%- endif -%}
  </button>
</div>

